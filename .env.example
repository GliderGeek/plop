# Kopieer naar .env en vul in; zonder SECRET_KEY en CHAMPAGNE_WACHTWOORD start de app niet.

# Ondertekent de inlogcookie. Genereer met:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Het gedeelde wachtwoord. Wijzigen (en de app herstarten) logt iedereen uit.
CHAMPAGNE_WACHTWOORD=

# 1 zodra de site via https draait: de cookie gaat dan alleen over https.
CHAMPAGNE_HTTPS=0
